#!/bin/sh
# The resolver's entry point on PATH, for both callers: an agent's shell inside a session,
# and a person warming a reference from their terminal.
#
# Claude Code puts every installed plugin's bin/ directory on PATH, so shipping this file is
# the whole of "put get-secret on PATH" — nothing written into $HOME, and nothing to re-point
# when the version-stamped plugin root changes.
#
# The interpreter is named here rather than left to the script's shebang, so the script runs
# the same way wherever Claude Code does.
exec zsh "$(dirname "$0")/../scripts/get-secret" "$@"
