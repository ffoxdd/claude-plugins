#!/bin/zsh
# Resolves a 1Password secret, caching it in the login keychain so the biometric prompt happens
# once per secret rather than once per invocation. The secret is identified by its own op://
# reference — there is no name to register, and nothing to keep in step with 1Password.
#
# Staleness is not guessed at. A cached copy lives until something rejects it, at which point
# the caller invalidates and retries. Checking a cached value against 1Password would cost the
# very prompt the cache exists to avoid, so rejection at the point of use is the only cheap
# signal available; a time-to-live would be an estimate standing in for one.
#
# This prints the secret and nothing else. Handing it to a tool is the caller's business —
# clickup-cli wants it in CLICKUP_TOKEN, curl wants it in a header — so a caller assigns and
# exports it itself rather than this script guessing at a destination.

set -u

KEYCHAIN_SERVICE="get-secret"

# A multi-line secret is base64'd to a single line, because the write below would otherwise lose
# everything after the first line. Single-line secrets are stored verbatim: encoding inflates by
# a third, which would push values that comfortably fit the write's 128-byte ceiling past it. The
# marker is what tells the two apart on read, and its absence is what keeps values cached before
# any encoding existed readable.
CACHE_ENCODING_MARKER="base64:"

encode_for_cache() {
  case "$1" in
    *$'\n'*)
      printf '%s%s' "$CACHE_ENCODING_MARKER" "$(printf '%s' "$1" | base64 | tr -d '\n')"
      ;;
    *)
      printf '%s' "$1"
      ;;
  esac
}

# Only needed to disambiguate when more than one 1Password account is signed in — a personal
# and a work one, say. Unset, `op` uses its default, which is right on a single-account machine.
typeset -a account_option=()
[[ -n "${GET_SECRET_OP_ACCOUNT:-}" ]] && account_option=(--account "$GET_SECRET_OP_ACCOUNT")

print_usage() {
  cat >&2 <<'USAGE'
Usage: get-secret <op-reference>              resolve to stdout, from the cache when present
       get-secret <op-reference> --refresh    discard the cached copy, re-read, re-cache
       get-secret --invalidate <op-reference> drop the cached copy
       get-secret --list                      op:// references cached on this machine

Example: get-secret 'op://Employee/Clickup API Token/credential'
USAGE
}

# Reports what is actually cached rather than what someone declared, which is the list worth
# having when rotating: a declaration can be stale, the keychain cannot. Attributes only — no
# -d, so no secret is dumped and nothing prompts. Accounts are emitted before services within
# each record, so by the time the service matches, the account has been seen.
list_cached_references() {
  security dump-keychain 2>/dev/null | awk -v service="$KEYCHAIN_SERVICE" '
    /^keychain:/ { account = "" }
    /"acct"<blob>="/ {
      account = substr($0, index($0, "=\"") + 2)
      sub(/"$/, "", account)
    }
    $0 ~ "\"svce\"<blob>=\"" service "\"" { if (account != "") print account }
  ' | sort
}

read_cached_secret() {
  local stored
  stored="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" -w 2>/dev/null)" || return 1

  case "$stored" in
    "$CACHE_ENCODING_MARKER"*)
      printf '%s' "${stored#$CACHE_ENCODING_MARKER}" | base64 --decode
      ;;
    *)
      printf '%s' "$stored"
      ;;
  esac
}

drop_cached_secret() {
  security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$1" >/dev/null 2>&1
}

# `security -w` with no value reads the payload AND a retype confirmation from the same stdin, so
# it is supplied twice and never appears on a command line where ps could see it. Supplying it
# once leaves the retype reading EOF, which matches empty against empty and stores an empty
# secret while still exiting 0; and the write silently truncates at 128 bytes. Both are invisible
# at write time, so the only way to know the secret is really there is to read it back.
CACHE_PAYLOAD_LIMIT_BYTES=128

cache_secret() {
  local reference="$1" value="$2" payload
  payload="$(encode_for_cache "$value")"

  printf '%s\n%s\n' "$payload" "$payload" \
    | security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$reference" -U -w >/dev/null 2>&1

  if [[ "$(read_cached_secret "$reference")" != "$value" ]]; then
    drop_cached_secret "$reference"
    echo "get-secret: '$reference' did not survive the keychain write, so it is not cached." >&2
    if (( ${#payload} > CACHE_PAYLOAD_LIMIT_BYTES )); then
      echo "get-secret: it stores ${#payload} bytes, over the ${CACHE_PAYLOAD_LIMIT_BYTES}-byte ceiling; it will re-prompt each call." >&2
    fi
    return 1
  fi
}

# Assigned before anything is emitted. Resolving inline would let an empty result read as a
# successful lookup of an empty secret, which a caller that fails closed could not tell apart
# from a real value by exit status alone.
# 1Password raises its approval on the desktop, not in the terminal. Where a person is
# watching that is a question; where one is not — an agent's shell, a hook, anything with no
# terminal on stderr — it is a dialog nobody sees attached to a command that appears to hang,
# and the session reports whatever it eventually gets as though resolving had been free. So a
# cold cache fails here, naming what would warm it, rather than spending an approval blind.
# Set GET_SECRET_ALLOW_PROMPT=1 to resolve anyway when you know someone is at the keyboard.
refuse_unattended_prompt() {
  local reference="$1"

  [[ -t 2 || -n "${GET_SECRET_ALLOW_PROMPT:-}" ]] && return 0

  echo "get-secret: '$reference' is not cached, and resolving it would raise a 1Password" >&2
  echo "get-secret: approval on the desktop that this session cannot see or answer." >&2
  echo "get-secret: warm it from a terminal: get-secret '$reference' --refresh" >&2
  return 1
}

fetch_secret() {
  local reference="$1" value
  refuse_unattended_prompt "$reference" || return 1
  if ! value="$(op read "${account_option[@]}" "$reference")" || [[ -z "$value" ]]; then
    echo "get-secret: could not resolve '$reference' from 1Password." >&2
    if [[ -n "${GET_SECRET_OP_ACCOUNT:-}" ]]; then
      echo "get-secret: sign in with: op signin --account $GET_SECRET_OP_ACCOUNT" >&2
    else
      echo "get-secret: sign in with: op signin" >&2
    fi
    return 1
  fi
  # A secret that cannot be cached is still a secret the caller asked for. Caching is the
  # optimisation; withholding the value because the optimisation failed would make a large
  # secret unresolvable rather than merely slow.
  cache_secret "$reference" "$value"
  printf '%s' "$value"
}

resolve_secret() {
  local reference="$1" refresh="$2" cached

  if [[ "$refresh" == true ]]; then
    drop_cached_secret "$reference"
  else
    cached="$(read_cached_secret "$reference")"
    [[ -n "$cached" ]] && { printf '%s' "$cached"; return 0; }
  fi

  fetch_secret "$reference"
}

if (( $# == 0 )); then
  print_usage
  exit 2
fi

case "$1" in
  -h|--help)
    print_usage
    exit 0
    ;;
  --list)
    list_cached_references
    exit 0
    ;;
  --invalidate)
    shift
    (( $# == 1 )) || { print_usage; exit 2; }
    drop_cached_secret "$1"
    exit 0
    ;;
esac

reference=""
force_refresh=false
while (( $# )); do
  case "$1" in
    --refresh) force_refresh=true ;;
    -*) echo "get-secret: unknown option $1" >&2; print_usage; exit 2 ;;
    *) reference="$1" ;;
  esac
  shift
done

[[ -n "$reference" ]] || { print_usage; exit 2; }

# op:// is asserted rather than assumed: a bare item name would otherwise reach `op read` and
# fail with its own error, which reads as a missing secret instead of a malformed argument.
if [[ "$reference" != op://* ]]; then
  echo "get-secret: '$reference' is not an op:// reference." >&2
  print_usage
  exit 2
fi

secret_value="$(resolve_secret "$reference" "$force_refresh")" || exit 1
printf '%s\n' "$secret_value"
