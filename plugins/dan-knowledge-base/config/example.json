{
  "session_example_not_enabled": {"required_variable": "<set by your covered session's launcher; rename this key to \"session\" to require it>"},

  "layout": {
    "inbox": "inbox",
    "processed": "inbox/processed",
    "retention_days": 90,
    "notes": "notes",
    "watermarks": "notes/.sync-state"
  },

  "sources": {
    "email": {
      "adapter": "email",
      "feeds": ["notes/meetings", "notes/team/log.md"],
      "watermark": {"format": "iso-8601", "boundary": "exclusive"},
      "ledger": "notes/.delivery-ledger",
      "ledger_retention_days": 180,
  "max_lookback_days": 90,
      "graph": {
        "client_id": "<the mail MCP server's own client id>",
        "tenant_id": "<your tenant id>",
        "credential_cache": null
      },
      "senders": [
        {
          "match": "domain",
          "value": "fathom.video",
          "observed": "no-reply@fathom.video",
          "body_ends_at": "[FATHOM]"
        }
      ],
      "shape_signatures": ["ask fathom", "view meeting", "shared a recap"]
    },

    "meetings": {
      "adapter": "fathom",
      "feeds": ["notes/meetings", "notes/team/log.md"],
      "watermark": {"format": "iso-8601", "boundary": "exclusive"},
      "ledger": "notes/.fathom-ledger",
      "lookback_hours": 72,
      "max_lookback_days": 90,
      "excluded_invitee_domains": ["<a client whose contract forbids AI use of its meetings>"],
      "transcripts": true,
      "credential": {"key_file": "~/.config/fathom/api-key"}
    },

    "chat": {
      "adapter": "chat",
      "feeds": ["notes/"],
      "watermark": {"format": "epoch-seconds", "boundary": "inclusive"},
      "excluded_conversations": ["#legal-*"],
      "private_topic_markers": ["may contain personal data"],
      "marked_conversations": "exclude",
      "history_limit": 1000,
      "replies_limit": 200
    },

    "wiki": {
      "adapter": "notion-sweep",
      "covered_by": "notion-records",
      "feeds": ["notes/"],
      "watermark": {"format": "iso-8601", "boundary": "inclusive at the minute"},
      "ledger": "notes/.notion-ledger",
      "index_lag_hours": 72
    },

    "notion-records": {
      "adapter": "notion",
      "feeds": ["notes/"],
      "watermark": {"format": "iso-8601", "boundary": "inclusive at the minute"},
      "covered_locations": [
        {"name": "<an operations hub whose pages list individuals>", "id": "<page id>"},
        {"name": "<a database with one row per person>", "id": "<database id>", "kind": "database"}
      ],
      "open_locations": [
        {"name": "<an engineering wiki that names no individual>", "id": "<page id>"}
      ],
      "max_depth": 4,
      "ledger": "notes/.notion-records-ledger",
      "index_lag_hours": 72
    },

    "task-board": {
      "adapter": null,
      "requires": {"mcp": ["<the task board's MCP server>"]},
      "feeds": ["notes/delivery/board.md"],
      "watermark": {"format": "epoch-milliseconds", "boundary": "exclusive"},
      "scope_control": {"container": "<a container known to be empty>", "expected_items": 0}
    },

    "design-boards": {
      "adapter": null,
      "requires": {"mcp": ["<the design tool's MCP server>"]},
      "reactive": true,
      "feeds": ["notes/design"],
      "known_documents": {"Sprint Planning": "<stable-file-key>"}
    }
  }
}
