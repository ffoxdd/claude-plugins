{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/permit_slack_client.py\"",
            "statusMessage": "approving a slack-client read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/provision.py\"",
            "statusMessage": "checking knowledge-base sources"
          }
        ]
      }
    ]
  }
}
